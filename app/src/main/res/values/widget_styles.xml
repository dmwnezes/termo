<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textColor">#FFF4F1FF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetRow.Large">
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="WTitle">
        <item name="android:fontFamily">@font/outfit_extrabold</item>
        <item name="android:textColor">#FFF4F1FF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WMuted">
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textColor">#FFA9A2D0</item>
    </style>

    <style name="WPill">
        <item name="android:background">@drawable/widget_pill</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">#FFF4F1FF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- Botão de alternativa do Palavra Relâmpago -->
    <style name="WOption">
        <item name="android:background">@drawable/wbtn</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">#FFF4F1FF</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
    </style>

    <style name="WPlay">
        <item name="android:background">@drawable/wbtn_play</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">#FF1A1438</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="WSquare">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_marginEnd">3dp</item>
    </style>

    <style name="WDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/wday_none</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">#FFF4F1FF</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
