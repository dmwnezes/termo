<?xml version="1.0" encoding="utf-8"?>
<!-- Hoje (grande): sequência, barra do dia, lista e botão para jogar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView style="@style/WTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Palavreiro" android:textSize="21sp" />
        <TextView android:id="@+id/w_streak" style="@style/WPill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔥 4" android:textSize="15sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_progress" style="@style/WMuted" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="3 de 5 hoje" android:textSize="14sp" />

    <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
        android:max="5" android:progress="3" android:progressDrawable="@drawable/wprogress" />

    <TextView android:id="@+id/w_termo" style="@style/WidgetRow.Large" android:text="✓  Termo" />
    <TextView android:id="@+id/w_dueto" style="@style/WidgetRow.Large" android:text="✓  Dueto" />
    <TextView android:id="@+id/w_quarteto" style="@style/WidgetRow.Large" android:text="○  Quarteto" />
    <TextView android:id="@+id/w_conexoes" style="@style/WidgetRow.Large" android:text="✓  Conexões" />
    <TextView android:id="@+id/w_caca" style="@style/WidgetRow.Large" android:text="○  Caça-Palavras" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView android:id="@+id/w_play" style="@style/WPlay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Jogar o Termo do dia" />
</LinearLayout>
