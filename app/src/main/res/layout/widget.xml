<?xml version="1.0" encoding="utf-8"?>
<!-- Hoje (médio): sequência e lista dos desafios do dia -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView style="@style/WTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Palavreiro"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/w_streak"
            style="@style/WPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 4" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_progress"
        style="@style/WMuted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:text="3 de 5 hoje"
        android:textSize="12sp" />

    <TextView android:id="@+id/w_termo" style="@style/WidgetRow" android:text="✓  Termo" />
    <TextView android:id="@+id/w_dueto" style="@style/WidgetRow" android:text="✓  Dueto" />
    <TextView android:id="@+id/w_quarteto" style="@style/WidgetRow" android:text="○  Quarteto" />
    <TextView android:id="@+id/w_conexoes" style="@style/WidgetRow" android:text="✓  Conexões" />
    <TextView android:id="@+id/w_caca" style="@style/WidgetRow" android:text="○  Caça-Palavras" />
</LinearLayout>
