<?xml version="1.0" encoding="utf-8"?>
<!-- Palavra Relâmpago (compacto): definição, 3 palavras lado a lado, resultado e Próxima -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView style="@style/WTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⚡ Palavra Relâmpago" android:textSize="15sp" />
        <TextView android:id="@+id/w_streak" style="@style/WPill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔥 3" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_def" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:fontFamily="@font/outfit_medium" android:textColor="#FFF4F1FF"
        android:text="Sentimento de falta de alguém, de um lugar ou de um tempo que ficou para trás."
        android:textSize="13sp" android:maxLines="3" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_opt0" style="@style/WOption" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:textSize="14sp" android:text="SAUDADE" />
        <TextView android:id="@+id/w_opt1" style="@style/WOption" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:textSize="14sp" android:text="JANGADA" />
        <TextView android:id="@+id/w_opt2" style="@style/WOption" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:textSize="14sp" android:text="CUSCUZ" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_feedback" style="@style/WMuted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Qual palavra é essa?" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_next" style="@style/WPill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Próxima ›" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
