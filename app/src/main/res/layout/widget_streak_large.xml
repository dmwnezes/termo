<?xml version="1.0" encoding="utf-8"?>
<!-- Sequência (grande): dias, recorde, últimos 7 dias e botão para jogar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView style="@style/WTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Sequência" android:textSize="19sp" />
        <TextView android:id="@+id/w_best" style="@style/WPill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="recorde 20" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/w_flame" android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/wcircle" android:gravity="center" android:text="🔥" android:textSize="36sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:id="@+id/w_days" style="@style/WTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12" android:textSize="52sp" android:includeFontPadding="false" />
                <TextView android:id="@+id/w_unit" style="@style/WMuted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:layout_marginBottom="6dp" android:text="dias" android:textSize="18sp" />
            </LinearLayout>
            <TextView android:id="@+id/w_label" style="@style/WMuted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="sequência no Termo" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView style="@style/WMuted" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" android:text="Últimos 7 dias" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_day1" style="@style/WDay" android:text="S" />
        <TextView android:id="@+id/w_day2" style="@style/WDay" android:text="T" />
        <TextView android:id="@+id/w_day3" style="@style/WDay" android:text="Q" />
        <TextView android:id="@+id/w_day4" style="@style/WDay" android:text="Q" />
        <TextView android:id="@+id/w_day5" style="@style/WDay" android:text="S" />
        <TextView android:id="@+id/w_day6" style="@style/WDay" android:text="S" />
        <TextView android:id="@+id/w_day7" style="@style/WDay" android:text="D" />
    </LinearLayout>
    <TextView android:id="@+id/w_play" style="@style/WPlay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Jogar o Termo do dia" />
</LinearLayout>
