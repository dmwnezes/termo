<?xml version="1.0" encoding="utf-8"?>
<!-- Sequência (médio): chama, dias, recorde -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <TextView android:id="@+id/w_flame" android:layout_width="56dp" android:layout_height="56dp"
        android:background="@drawable/wcircle" android:gravity="center" android:text="🔥" android:textSize="28sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <TextView android:id="@+id/w_days" style="@style/WTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12" android:textSize="34sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_unit" style="@style/WMuted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:layout_marginBottom="3dp" android:text="dias" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:id="@+id/w_label" style="@style/WMuted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="sequência no Termo" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/w_best" style="@style/WPill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="recorde 20" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
